# Example environment configuration
# Copy to .env and adjust values

# Required for direct source use. Compose overrides this with /data/collection.anki2.
ANKICONNECT_COLLECTION_PATH=./anki-data/collection.anki2

# Optional - Server settings
ANKICONNECT_PORT=8765
ANKICONNECT_BIND=127.0.0.1

# Required whenever another machine can reach the API: every AnkiConnect client must send it
# (Yomitan: Settings > Anki > API key). Generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ANKICONNECT_API_KEY=

# Optional - web origins allowed to call the API from a browser page (comma-separated).
# Browser extensions such as Yomitan are allowed already; set CORS_EXTENSIONS=false to refuse them.
# ANKICONNECT_CORS_ORIGINS=https://jellyfin.example.org
# ANKICONNECT_CORS_EXTENSIONS=true

# Optional - AnkiWeb sync (required for the sync action and automatic sync)
# ANKICONNECT_ANKIWEB_USER=your@email.com
# ANKICONNECT_ANKIWEB_PASS=your_password

# Optional - Custom sync server (default: AnkiWeb)
# ANKICONNECT_ANKIWEB_URL=https://sync.ankiweb.net

# Optional - sync with AnkiWeb by itself: DELAY seconds after the last change (at most five
# times that during a long session) and every INTERVAL seconds to pull changes from elsewhere.
# ANKICONNECT_AUTO_SYNC=true
# ANKICONNECT_AUTO_SYNC_DELAY=30
# ANKICONNECT_AUTO_SYNC_INTERVAL=600

# Optional - loopback port of the MCP endpoint that `serve` runs for the tunnel
# ANKICONNECT_MCP_PORT=8766

# Required by the tunnel commands and the default Compose service
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# Optional - Override tunnel-client discovery when it is not on PATH
# TUNNEL_CLIENT_PATH=/path/to/tunnel-client
